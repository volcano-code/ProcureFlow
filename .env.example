# Reference only: scripts/start.py reads process environment, NOT this file automatically.
PF_MODE=demo
PF_ERP_MODE=mock
# Explicit browser origins, with no trailing slash.
PF_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PF_DATA_DIR=/absolute/path/to/procureflow-data
# PF_DATABASE_URL=sqlite:////absolute/path/to/procureflow-data/procureflow.sqlite3
# private is a local/private alpha mode, NOT production SSO.
# PF_AUTH_TOKENS={"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS":{"user_id":"buyer-01","tenant_id":"workspace-01","role":"buyer"},"REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS":{"user_id":"approver-01","tenant_id":"workspace-01","role":"approver"}}

# Optional read-only explanation adapter. No real-model run has been verified.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=

# ERPNext (even read-only) requires PF_MODE=private, PF_ERP_MODE=erpnext, and private identities.
# Optional ERPNext adapter. Synthetic disposable labs are separate from any user ERP.
ERP_BASE_URL=
ERP_API_KEY=
ERP_API_SECRET=
ERP_COMPANY=
ERP_ALLOW_DRAFT_WRITES=false

# Explicit integration probes only; do not commit real values.
PF_INTEGRATION_ENVIRONMENT=sandbox
ERP_EXPECTED_INTEGRATION_USER=
# Provider-specific opt-in, default sends no thinking parameter.
LLM_THINKING_MODE=default

# Explicit existing company accounts for draft cost rows; reviewed in approval snapshot.
# No accounts or permissions are created by the runtime adapter.
ERP_TAX_ACCOUNT=
ERP_FREIGHT_ACCOUNT=
